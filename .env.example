# Keep API calls same-origin: Vite proxies /api locally, Vercel rewrites it in
# production. Do not point VITE_API_BASE_URL at the sandbox directly from the
# browser: the sandbox does not allow cross-origin requests.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://sandbox.iniil.me
# Optional public origin for localhost asset URLs returned by the backend.
VITE_ASSET_BASE_URL=
# Optional invoice identity labels.
VITE_COMPANY_NAME=BookStore Indonesia
VITE_COMPANY_ADDRESS=Jakarta, Indonesia
